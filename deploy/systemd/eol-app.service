[Unit]
Description=EOL test stand: application (screens, database, Testing)
After=eol-acquire.service eol-heartbeat.service
Wants=eol-acquire.service eol-heartbeat.service

[Service]
User=@USER@
EnvironmentFile=/etc/eol/eol.env
ExecStart=@PREFIX@/venv/bin/python -m eol_app serve --host 127.0.0.1 --port 8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
